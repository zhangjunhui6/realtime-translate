{
  "name": "realtime-translate",
  "private": true,
  "version": "0.1.0",
  "description": "Face-to-face turn-taking Chinese↔English conversation translator (Web/PWA)",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm run test -w server"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
